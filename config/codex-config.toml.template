# Codex provider config pointing at the CodexBridge.exe bridge.
# Copy to ~/.codex/config.toml (UTF-8 WITHOUT BOM) and replace __MODEL__
# with your gateway model name. After that, the bridge WebUI
# (http://127.0.0.1:8789/) keeps the `model` line in sync whenever you
# switch providers, and leaves every other setting alone.
#
# How the chain works:
#
#   Codex CLI / official desktop App  ->  127.0.0.1:8787 (CodexBridge.exe)  ->  your gateway
#
# Codex 0.169+ only speaks the Responses API (wire_api = "chat" was removed).
# The bridge translates Responses -> Chat Completions for chat-only gateways
# and can neutralise the Codex prompt fingerprint (11128 channel check).
# The real upstream URL/key live in the bridge (WebUI), not in this file.

model = "__MODEL__"
model_reasoning_effort = "high"
model_provider = "bridge"

[model_providers.bridge]
name = "Bridge (api2codex)"
base_url = "http://127.0.0.1:8787/v1"
wire_api = "responses"

# Optional: static model catalog for the official desktop App's model picker.
# The WebUI rebuilds this file automatically when you switch providers.
# model_catalog_json = "C:/Users/<you>/.codex/model_catalog.json"

# Reference: talking to the gateway directly (no bridge). Use this only if
# your gateway serves /v1/responses natively.
#
# [model_providers.direct]
# name = "Direct"
# base_url = "__UPSTREAM_BASE_URL__"
# wire_api = "responses"
# env_key = "UPSTREAM_API_KEY"