# Codex CLI provider config pointing at CC Switch's local proxy.
# The installer substitutes __UPSTREAM_BASE_URL__ and __MODEL__.
#
# How the chain works:
#
#   CC GUI / Codex CLI  ->  127.0.0.1:15721 (CC Switch proxy)  ->  your gateway
#
# Codex 0.169+ only speaks the Responses API (wire_api = "chat" was removed),
# so CC Switch has to translate Responses -> Chat Completions for gateways that
# only expose /v1/chat/completions. That is what the "Upstream format" setting
# on the provider card controls: set it to "Chat Completions".

model = "__MODEL__"
model_reasoning_effort = "high"
model_provider = "ccswitch"

[model_providers.ccswitch]
name = "CC Switch Local Proxy"
base_url = "http://127.0.0.1:15721/v1"
wire_api = "responses"
requires_openai_auth = false
# CC Switch injects the real upstream key itself; this placeholder just has to
# be present so the proxy accepts the request.
experimental_bearer_token = "PROXY_MANAGED"

# Reference: talking to the gateway directly (no CC Switch). Use this only if
# your gateway serves /v1/responses natively.
#
# [model_providers.direct]
# name = "Direct"
# base_url = "__UPSTREAM_BASE_URL__"
# wire_api = "responses"
# env_key = "UPSTREAM_API_KEY"
